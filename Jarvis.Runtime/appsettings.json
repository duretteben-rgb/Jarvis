{
  "Jarvis": {
    "InstanceName": "JARVIS OS",
    "HeartbeatIntervalSeconds": 5
  },
  "Plugins": {
    "Enabled": true,
    "Directory": "plugins",
    "WatchEnabled": true,
    "WatchDebounceMs": 1500
  },
  "Permissions": {
    "AllowAll": true
  },
  "Memory": {
    "Enabled": true,
    "DatabasePath": "data/jarvis-memory.db",
    "MaxSearchResults": 10
  },
  "Embeddings": {
    "Provider": "hash",
    "Model": "nomic-embed-text",
    "Endpoint": "http://localhost:11434"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Warning",
      "Microsoft": "Warning",
      "System": "Warning"
    }
  }
}
