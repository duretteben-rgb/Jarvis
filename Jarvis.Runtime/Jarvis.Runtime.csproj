<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Jarvis.Runtime</RootNamespace>
    <AssemblyName>Jarvis.Runtime</AssemblyName>
    <Description>Main application host of JARVIS OS. Boots the core, loads plugins and runs background services.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jarvis.Core\Jarvis.Core.csproj" />
    <ProjectReference Include="..\Jarvis.Memory\Jarvis.Memory.csproj" />
    <ProjectReference Include="..\Jarvis.SDK\Jarvis.SDK.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Import Project="..\build\Jarvis.PluginDeploy.targets" />

</Project>
