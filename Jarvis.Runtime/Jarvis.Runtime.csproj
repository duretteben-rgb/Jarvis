<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Jarvis.Runtime</RootNamespace>
    <AssemblyName>Jarvis.Runtime</AssemblyName>
    <Description>Main application host of JARVIS OS. Boots the core, loads plugins and runs background services.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jarvis.Core\Jarvis.Core.csproj" />
    <ProjectReference Include="..\Jarvis.Memory\Jarvis.Memory.csproj" />
    <ProjectReference Include="..\Jarvis.SDK\Jarvis.SDK.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Build every plugin project and deploy its output into the runtime output so the plugin
       loader can discover it. Each plugin ends up in plugins/<AssemblyName>/. -->
  <Target Name="DeployPlugins" AfterTargets="Build" Condition="'$(Configuration)' != 'Publish'">
    <ItemGroup>
      <PluginProject Include="..\Jarvis.Plugins\*\*.csproj" />
    </ItemGroup>
    <MSBuild Projects="@(PluginProject)"
             Targets="Build"
             Properties="Configuration=$(Configuration)" />
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="DeploySinglePlugin"
             Properties="Configuration=$(Configuration);PluginDir=%(PluginProject.RootDir)%(PluginProject.Directory);PluginName=%(PluginProject.Filename)"
             BuildInParallel="true" />
  </Target>

  <Target Name="DeploySinglePlugin" Condition="'$(Configuration)' != 'Publish'">
    <ItemGroup>
      <PluginOutput Include="$(PluginDir)bin\$(Configuration)\net8.0\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginOutput)"
          DestinationFiles="$(OutDir)plugins\$(PluginName)\%(RecursiveDir)%(Filename)%(Extension)" />
  </Target>

</Project>
