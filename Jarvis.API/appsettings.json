{
  "Urls": "http://localhost:5178",
  "Jarvis": {
    "InstanceName": "JARVIS OS",
    "HeartbeatIntervalSeconds": 5
  },
  "Plugins": {
    "Enabled": true,
    "Directory": "plugins",
    "WatchEnabled": true,
    "WatchDebounceMs": 1500
  },
  "Permissions": {
    "AllowAll": true
  },
  "Memory": {
    "Enabled": true,
    "DatabasePath": "data/jarvis-memory.db",
    "MaxSearchResults": 10
  },
  "Embeddings": {
    "Provider": "hash",
    "Model": "nomic-embed-text",
    "Endpoint": "http://localhost:11434"
  },
  "AI": {
    "Ollama": {
      "Enabled": true,
      "Endpoint": "http://localhost:11434",
      "Model": "llama3.2"
    },
    "OpenAI": {
      "Enabled": false,
      "DisplayName": "Groq (free cloud)",
      "BaseUrl": "https://api.groq.com/openai/v1",
      "ApiKey": "",
      "Model": "llama-3.3-70b-versatile"
    },
    "Models": [
      {
        "Id": "local-llama",
        "Provider": "ollama",
        "Model": "llama3.2",
        "DisplayName": "Llama 3.2 (local)",
        "IsDefault": true,
        "Tags": [ "fast", "offline" ]
      },
      {
        "Id": "local-mistral",
        "Provider": "ollama",
        "Model": "mistral",
        "DisplayName": "Mistral (local)",
        "Tags": [ "fast", "offline", "reasoning" ]
      },
      {
        "Id": "groq-llama",
        "Provider": "openai",
        "Model": "llama-3.3-70b-versatile",
        "DisplayName": "Llama 3.3 70B (Groq)",
        "Tags": [ "powerful", "coding", "reasoning", "summarize" ]
      },
      {
        "Id": "groq-fast",
        "Provider": "openai",
        "Model": "llama-3.1-8b-instant",
        "DisplayName": "Llama 3.1 8B (Groq)",
        "Tags": [ "fast" ]
      }
    ],
    "Routing": {
      "PreferLocal": true,
      "AvailabilityTtlSeconds": 15,
      "ConsecutiveFailuresBeforeCooldown": 3,
      "CooldownSeconds": 30
    },
    "Context": {
      "MaxTokens": 4096,
      "MaxSessions": 100
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Warning",
      "Microsoft": "Warning",
      "System": "Warning"
    }
  }
}
