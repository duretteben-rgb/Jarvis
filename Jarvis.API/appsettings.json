{
  "Urls": "http://localhost:5178",
  "Jarvis": {
    "InstanceName": "JARVIS OS",
    "HeartbeatIntervalSeconds": 5
  },
  "Plugins": {
    "Enabled": true,
    "Directory": "plugins",
    "WatchEnabled": true,
    "WatchDebounceMs": 1500
  },
  "Permissions": {
    "AllowAll": true
  },
  "Memory": {
    "Enabled": true,
    "DatabasePath": "data/jarvis-memory.db",
    "MaxSearchResults": 10
  },
  "Embeddings": {
    "Provider": "hash",
    "Model": "nomic-embed-text",
    "Endpoint": "http://localhost:11434"
  },
  "AI": {
    "Ollama": {
      "Enabled": true,
      "Endpoint": "http://localhost:11434",
      "Model": "llama3.2:1b"
    },
    "OpenAI": {
      "Enabled": false,
      "DisplayName": "Groq (free cloud)",
      "BaseUrl": "https://api.groq.com/openai/v1",
      "ApiKey": "",
      "Model": "llama-3.3-70b-versatile"
    },
    "OpenAICompat": [
      {
        "Id": "openrouter",
        "Enabled": false,
        "DisplayName": "OpenRouter (many free models)",
        "BaseUrl": "https://openrouter.ai/api/v1",
        "ApiKey": "",
        "EnvironmentVariable": "JARVIS_OPENROUTER_API_KEY",
        "Model": "meta-llama/llama-3.3-70b-instruct:free"
      },
      {
        "Id": "gemini",
        "Enabled": false,
        "DisplayName": "Google Gemini (free tier)",
        "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/openai",
        "ApiKey": "",
        "EnvironmentVariable": "JARVIS_GEMINI_API_KEY",
        "Model": "gemini-2.5-flash"
      },
      {
        "Id": "deepseek",
        "Enabled": false,
        "DisplayName": "DeepSeek (very cheap)",
        "BaseUrl": "https://api.deepseek.com/v1",
        "ApiKey": "",
        "EnvironmentVariable": "JARVIS_DEEPSEEK_API_KEY",
        "Model": "deepseek-chat"
      }
    ],
    "Models": [
      {
        "Id": "local-llama",
        "Provider": "ollama",
        "Model": "llama3.2:1b",
        "DisplayName": "Llama 3.2 1B (local)",
        "IsDefault": true,
        "Tags": [ "fast", "offline" ]
      },
      {
        "Id": "local-mistral",
        "Provider": "ollama",
        "Model": "mistral",
        "DisplayName": "Mistral (local)",
        "Tags": [ "fast", "offline", "reasoning" ]
      },
      {
        "Id": "groq-llama",
        "Provider": "openai",
        "Model": "llama-3.3-70b-versatile",
        "DisplayName": "Llama 3.3 70B (Groq)",
        "Tags": [ "powerful", "coding", "reasoning", "summarize" ]
      },
      {
        "Id": "groq-fast",
        "Provider": "openai",
        "Model": "llama-3.1-8b-instant",
        "DisplayName": "Llama 3.1 8B (Groq)",
        "Tags": [ "fast" ]
      },
      {
        "Id": "groq-gpt-oss",
        "Provider": "openai",
        "Model": "openai/gpt-oss-20b",
        "DisplayName": "GPT-OSS 20B (Groq)",
        "Tags": [ "powerful", "reasoning", "summarize" ]
      },
      {
        "Id": "groq-qwen",
        "Provider": "openai",
        "Model": "qwen/qwen3.6-27b",
        "DisplayName": "Qwen 3.6 27B (Groq)",
        "Tags": [ "powerful", "reasoning", "coding" ]
      }
    ],
    "Routing": {
      "PreferLocal": true,
      "AvailabilityTtlSeconds": 15,
      "ConsecutiveFailuresBeforeCooldown": 3,
      "CooldownSeconds": 30
    },
    "Context": {
      "MaxTokens": 4096,
      "MaxSessions": 100
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Warning",
      "Microsoft": "Warning",
      "System": "Warning"
    }
  }
}
